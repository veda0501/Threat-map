# Supabase server credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Configuration
PORT=3000
NODE_ENV=development

# OSINT API Keys (Add your API keys here)
# US-CERT API
USCERT_API_KEY=your_uscert_key_here

# News API
NEWS_API_KEY=your_newsapi_key_here

# VirusTotal API
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# GDACS (Global Disaster Alert and Coordination System) - No key needed
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH

# WHO Disease Outbreak News
WHO_DON_URL=https://www.who.int/feeds/entity/csr/don/en/rss.xml

# MISP (Malware Information Sharing Platform) - Optional
MISP_URL=your_misp_instance_url
MISP_API_KEY=your_misp_key

# Update Intervals (in minutes)
CYBER_UPDATE_INTERVAL=15
HEALTH_UPDATE_INTERVAL=60
ECONOMIC_UPDATE_INTERVAL=30
POLITICAL_UPDATE_INTERVAL=30
DISASTER_UPDATE_INTERVAL=10
